rules_version = '2';

// RMD Instructor Weekend 2026 — Firestore Security Rules
//
// Two access levels:
//   - Public (unauthenticated): QR code arrivals, faculty pre-course form
//   - Authenticated: all faculty/director platform features
//   - Director: collections that decide who IS a director, plus admin-only lists
//
// To deploy: Firebase Console -> Firestore Database -> Rules -> paste and publish

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors DIRECTOR_EMAILS in js/firebase-config.js — keep these in sync.
    function directorEmails() {
      return [
        "console_brews.6f@icloud.com",
        "j.hulme.1@bham.ac.uk"
      ];
    }

    // True if the signed-in user is a director, checked the same way
    // resolveRole() does in firebase-config.js: people doc role, then the
    // hardcoded email list, then config/platform's directors array.
    function isDirector() {
      return isSignedIn() && (
        request.auth.token.email.lower() in directorEmails() ||
        (exists(/databases/$(database)/documents/people/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/people/$(request.auth.uid)).data.role == "director") ||
        (exists(/databases/$(database)/documents/config/platform) &&
          request.auth.token.email.lower() in get(/databases/$(database)/documents/config/platform).data.directors)
      );
    }

    // True if the signed-in user's people/{uid} doc has role == "faculty".
    // Candidates (instructor/assessor/itc) must never be able to write their own
    // assessment/observation records — only the faculty member assessing them,
    // or the director, can. This is what draws that line at the rules level.
    function isFaculty() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/people/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/people/$(request.auth.uid)).data.role == "faculty";
    }

    // True if the signed-in user's people/{uid} doc has role == "assessor-faculty".
    // Used to gate the assessor-stream timing/messaging portal (2026-07-21) —
    // this role may post to the assessor-stream target only, never "all",
    // "faculty", or "instructor-stream".
    function isAssessorFaculty() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/people/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/people/$(request.auth.uid)).data.role == "assessor-faculty";
    }

    // Can record/amend an assessment: faculty or director.
    function canAssess() {
      return isFaculty() || isDirector();
    }

    // ── People directory ────────────────────────────────────────────────────
    // Read: public — QR landing page looks up candidate name without login
    // Write: director only — this collection decides who counts as a director,
    //   so any signed-in user being able to write here is a privilege escalation
    match /people/{docId} {
      allow read: if true;
      allow write: if isDirector();
    }

    // ── Attendance ──────────────────────────────────────────────────────────
    // Create/update: public — candidates write their own arrival via QR scan
    // Read/delete: authenticated only — faculty dashboard and admin only
    match /attendance/{docId} {
      allow create, update: if true;
      allow read, delete: if isSignedIn();
    }

    // ── Faculty pre-course form ─────────────────────────────────────────────
    // Document ID is the lowercased submitter email (see faculty-form.html) —
    //   this lets a caller with no login look up/edit their own response via a
    //   direct-by-ID fetch, without ever needing to query/list the collection.
    // get:  public — caller must already know the exact email (= docId) to
    //   fetch one record. Residual risk: knowing someone's email is enough to
    //   see/overwrite their response — accepted trade-off for no-login editing.
    // list: director only — this is what stops anyone dumping every faculty
    //   member's dietary/accessibility/travel data in one unauthenticated query.
    // create/update: public — supports pre-login submit and edit-by-email re-open.
    // delete: authenticated only.
    match /faculty_responses/{docId} {
      allow get: if true;
      allow list: if isDirector();
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // ── Assessments ─────────────────────────────────────────────────────────
    // Read: any signed-in user, including candidates (they can see their own
    //   results; this collection isn't per-user scoped so this also means
    //   candidates can see others' — acceptable per current design, revisit if not).
    // Create/update: faculty or director only — candidates must never be able
    //   to write/alter their own or anyone else's assessment record.
    // Delete: director only — this is the "cannot be undone" action; faculty
    //   can correct a result by updating it, but never permanently remove one.
    match /assessments/{docId} {
      allow read: if isSignedIn();
      allow create, update: if canAssess();
      allow delete: if isDirector();
    }

    // ── Sessions ────────────────────────────────────────────────────────────
    // Authenticated only — programme schedule if managed via Firestore
    match /sessions/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── Messages ────────────────────────────────────────────────────────────
    // Read: authenticated — recipient filtering by role/stream happens
    //   client-side in timetable.html (isMessageForRole()), same posture as
    //   the rest of this ruleset (e.g. sessionsForRole filtering on the client).
    // Create: director can post any target. Assessor-faculty can post ONLY
    //   target == "assessor-stream" — this is the write-side enforcement of
    //   "assessor course faculty portal, assessor-stream audience only"
    //   (2026-07-21). No other role (including generic "faculty" and
    //   candidates) may create a message at all — matches the pre-existing
    //   posture where only the director's panel could send.
    // Update/delete: director only — previously any signed-in user could
    //   edit or delete any message (isSignedIn() covered write); tightened
    //   as part of this change since it was an open gap.
    match /messages/{docId} {
      allow read: if isSignedIn();
      allow create: if isDirector() ||
        (isAssessorFaculty() && request.resource.data.target == "assessor-stream");
      allow update, delete: if isDirector();
    }

    // ── Rooms ────────────────────────────────────────────────────────────────
    // Authenticated only — room state (timer, current message)
    match /rooms/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── Feedback ────────────────────────────────────────────────────────────
    // Authenticated only — faculty voice feedback transcripts
    match /feedback/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── ITC observations ────────────────────────────────────────────────────
    // Blind feedback (decided 2026-07-09): each observer's rating of an ITC
    //   must not be visible to other observers rating the same ITC — only
    //   the rater themselves and the director can see a given doc.
    // Read: the rater who wrote the doc (resource.data.raterUid), or director.
    //   NOTE: list queries (e.g. "my saved ratings for this session") must
    //   include .where("raterUid","==", auth.uid) for a non-director caller —
    //   itc-observations.html's loadMyRatings() does this. A query without
    //   that filter will be denied for non-directors, which is intentional:
    //   it's what stops one Instructor Trainer listing another's observations.
    // Create: faculty or director only, and only self-attributed
    //   (request.resource.data.raterUid must equal the caller) — the ITC
    //   being observed must never be able to write their own record, and no
    //   rater can write a doc claiming to be someone else's observation.
    // Update: same self-attribution check against the EXISTING doc
    //   (resource.data.raterUid) — a rater can only amend their own doc.
    // Delete: director only.
    match /itc_observations/{docId} {
      allow read: if isSignedIn() &&
        (isDirector() || resource.data.raterUid == request.auth.uid);
      allow create: if canAssess() &&
        request.resource.data.raterUid == request.auth.uid;
      allow update: if canAssess() &&
        resource.data.raterUid == request.auth.uid &&
        request.resource.data.raterUid == request.auth.uid;
      allow delete: if isDirector();
    }

    // ── ITC summaries (AI-generated) ────────────────────────────────────────
    // Written only by the generateItcSummary Cloud Function via the Admin
    // SDK, which bypasses these rules entirely — so "write: false" here is
    // just belt-and-braces against any client ever writing directly.
    // Read: director only — this is the collated, de-blinded view, so it
    //   must stay behind the same gate as the raw itc_observations aggregate.
    match /itc_summaries/{docId} {
      allow read: if isDirector();
      allow write: if false;
    }

    // ── Gateway assessments ─────────────────────────────────────────────────
    // Read: any signed-in user (candidate can see their own gateway outcome).
    // Create/update: faculty or director only — recordOutcome()/toggleFlag()/
    //   lockOutcome() in assessment-gateway.html are all faculty/director actions.
    // Delete: director only — a locked/recorded gateway outcome (pass/fail on
    //   whether a candidate continues to Sunday) must never be silently erasable
    //   by a faculty member; unlocking to correct it is a separate, non-destructive
    //   update (lockedAt: null), already handled above.
    match /gateway_assessments/{docId} {
      allow read: if isSignedIn();
      allow create, update: if canAssess();
      allow delete: if isDirector();
    }

    // ── Development assessments ─────────────────────────────────────────────
    // Read: any signed-in user (candidate can see their own RAG trajectory).
    // Create/update: faculty or director only.
    // Delete: director only.
    match /development_assessments/{docId} {
      allow read: if isSignedIn();
      allow create, update: if canAssess();
      allow delete: if isDirector();
    }

    // ── Platform config ──────────────────────────────────────────────────────
    // Read: authenticated — pages display the current director list
    // Write: director only — this is the OTHER place director status can be
    //   granted from (config/platform.directors), same escalation risk as people
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isDirector();
    }

    // ── MOU responses ───────────────────────────────────────────────────────
    // Create: authenticated — member submits their own MOU form response
    // Read/update/delete: director only — only directors review submissions
    match /mou_responses/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isDirector();
    }

    // ── MOU roster ──────────────────────────────────────────────────────────
    // Director only — expected member list, managed exclusively via director tools
    match /mou_roster/{docId} {
      allow read, write: if isDirector();
    }

    // ── Room groups ──────────────────────────────────────────────────────────
    // Read: authenticated — all staff need to see their room assignment
    //   (timetable.html room banner reads this for every signed-in user)
    // Write: director only — room allocation admin page
    match /groups/{docId} {
      allow read: if isSignedIn();
      allow write: if isDirector();
    }

    // ── IW registrations ────────────────────────────────────────────────────
    // Director only — director-managed attendee list for Instructor Weekend
    match /iw_registrations/{docId} {
      allow read, write: if isDirector();
    }

    // ── Summer meeting dietary requirements ─────────────────────────────────
    // Document ID is the lowercased submitter email (see summer-meeting-dietary.html)
    //   — same no-login edit-by-email pattern as faculty_responses.
    // get:  public — caller must already know the exact email (= docId).
    // list: director only — stops one unauthenticated request dumping every
    //   attendee's dietary/allergy data.
    // create/update: public — supports pre-login submit and resubmit-to-edit.
    // delete: authenticated only.
    match /summer_meeting_dietary/{docId} {
      allow get: if true;
      allow list: if isDirector();
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

  }
}
